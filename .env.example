DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm

# Core
API_URL=http://localhost:8002
API_ORGANIZATION=0000
API_KEY=changeme
API_SECRET=changeme

# Entra ID (mock em dev). Use o GUID do tenant: com "common" o issuer do token não bate com a URL.
AUTH_URL=http://localhost:8001
AUTH_TENANT=11111111-2222-3333-4444-555555555555
AUTH_CLIENT_ID=mock-app
AUTH_CLIENT_SECRET=mock-app-secret
AUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# BFF: para onde o callback devolve o usuário (front estático em /)
FRONTEND_URL=http://localhost:8000/
# Assina o cookie temporário do login. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=troque-isto-em-qualquer-ambiente-real
SESSION_COOKIE_SECURE=false
